# ===== AI 医院：后端运行配置 =====
# 复制本文件为 .env 后再启动，后端会自动读取。
# 模型既可用这里的环境变量直连，也可启动后在 /admin 后台里逐个配置。

# 默认模型的 API Key（OpenAI 兼容）。留空则启动后到 /admin 后台配置。
# 该 Key 会写入默认模型 "DeepSeek V4-Pro" 这一行，并在无其它启用模型时自动启用它。
USER_LLM_API_KEY=your-api-key-here

# 默认模型的 OpenAI 兼容接口地址（结尾不带斜杠；DeepSeek 通常为 https://api.deepseek.com/v1）
USER_LLM_BASE_URL=https://api.deepseek.com/v1

# 默认模型的模型名（需与上面接口/Key 的厂商匹配，例如 deepseek-v4-pro、glm-4.5-flash、qwen3.8-max）
USER_LLM_MODEL=deepseek-v4-pro

# 后端服务端口
PORT=3001

# 单次大模型请求超时（毫秒）
LLM_TIMEOUT_MS=120000

# 大模型并发上限（超出后排队，保护上游额度）
MAX_CONCURRENT_LLM=8

# SQLite 数据目录（默认 <项目根>/data；容器部署时指向挂载卷）
AIHOSPITAL_DATA_DIR=

# ===== 管理后台 =====
# 后台初始账号与密码（仅在数据库首次创建时写入），请务必改成强密码
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-admin-password
