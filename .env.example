# ===== AI 医院：大模型接入配置 =====
# 复制本文件为 .env 并填入你的真实配置
# 推荐使用国产模型（如 DeepSeek），OpenAI 兼容接口

# 你的 API Key（在 https://platform.deepseek.com 或对应厂商平台获取）
USER_LLM_API_KEY=your-api-key-here

# OpenAI 兼容接口地址（结尾不带 /v1）
USER_LLM_BASE_URL=https://api.deepseek.com

# 模型名称
USER_LLM_MODEL=deepseek-chat

# 服务端口（后端）
PORT=3001

# 请求超时时间（毫秒）
LLM_TIMEOUT_MS=120000

# 请求并发上限
MAX_CONCURRENT_LLM=8

# 未配置 API Key 时是否启用内置演示模式（模拟 AI 回复，便于预览）
# 生产环境请设为 false
DEMO_MODE=true

# ===== 管理后台 =====
# 后台登录密码（访问 /admin 时需要），请务必设置一个强密码
ADMIN_PASSWORD=your-admin-password
